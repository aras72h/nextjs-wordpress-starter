# =============================================================================
# apps/web — Next.js Environment Variables
# =============================================================================
# Copy this file to .env and fill in the values.
# The root .env handles Docker Compose / MySQL / infrastructure vars.
# This file is only for variables consumed by the Next.js app itself.
# =============================================================================

# WordPress REST API base URL
# Local dev: http://localhost:12080/wp-json/wp/v2
# Production: https://nws.arashworks.ir/wp-json/wp/v2
WORDPRESS_API_URL=http://localhost:12080/wp-json/wp/v2

# Public URL of this Next.js app (used for metadata, OG tags, etc.)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Shared secret between WordPress webhook and this app
# Must match REVALIDATION_SECRET in the root .env / WordPress container
REVALIDATION_SECRET=change-this-to-a-random-string

# Contact form SMTP (leave blank to disable email in local dev)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
CONTACT_EMAIL_TO=
