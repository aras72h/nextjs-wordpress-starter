# =============================================================================
# Next.js WordPress Starter — Environment Variables
# =============================================================================
# Copy this file to .env and fill in the values.
# .env is gitignored and will never be committed.
#
# Local development defaults are provided where safe to do so.
# Staging and production require all values to be set explicitly.
# =============================================================================


# -----------------------------------------------------------------------------
# MySQL
# -----------------------------------------------------------------------------
MYSQL_ROOT_PASSWORD=rootpass
MYSQL_DATABASE=starter_wp
MYSQL_USER=starter
MYSQL_PASSWORD=starterpass


# -----------------------------------------------------------------------------
# WordPress ↔ Next.js webhook
# Used by both the WordPress container and the Next.js revalidation API.
# Change REVALIDATION_SECRET to any random string before running.
# -----------------------------------------------------------------------------
REVALIDATION_SECRET=change-this-to-a-random-string
NEXTJS_REVALIDATE_URL=http://host.docker.internal:3000/api/revalidate


# -----------------------------------------------------------------------------
# Next.js
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
WORDPRESS_API_URL=http://localhost:12080/wp-json/wp/v2


# -----------------------------------------------------------------------------
# Contact form — SMTP
# Leave blank to disable email sending in local development.
# -----------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
CONTACT_EMAIL_TO=your@email.com


# -----------------------------------------------------------------------------
# Docker image (staging / production only)
# Set this to the full image reference your registry uses.
# Example: registry.example.com/myorg/web:latest
# -----------------------------------------------------------------------------
NEXTJS_IMAGE=
